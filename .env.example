# Local Ollama endpoint. No cloud API calls are made by this scaffold.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Persistent local database
VENTURE_LAB_DB=./data/venture_lab.sqlite3

# Hard application-level limit; set low while testing.
MAX_CYCLES_PER_DAY=5

# External actions are deliberately unavailable in this initial version.
ALLOW_EXTERNAL_ACTIONS=false
